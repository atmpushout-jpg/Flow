{
  "functions": {
    "api/fill/index.js": {
      "maxDuration": 30
    },
    "api/health/index.js": {
      "maxDuration": 10
    },
    "api/quote/index.js": {
      "maxDuration": 30
    },
    "api/smart-wallets/index.js": {
      "maxDuration": 10
    },
    "api/signals/index.js": {
      "maxDuration": 10
    },
    "api/forecaster/index.js": {
      "maxDuration": 10
    },
    "api/build/index.js": {
      "maxDuration": 10
    },
    "api/build/apply-tuning/index.js": {
      "maxDuration": 10
    },
    "api/arena/register/index.js": {
      "maxDuration": 10
    },
    "api/arena/results/index.js": {
      "maxDuration": 10
    },
    "api/passport/index.js": {
      "maxDuration": 10
    },
    "api/gigabyte-state/index.js": {
      "maxDuration": 10
    },
    "api/gigabyte-audio/index.js": {
      "maxDuration": 10
    },
    "api/gigabyte-push/index.js": {
      "maxDuration": 30
    }
  },
  "version": 2,
  "rewrites": [
    {
      "source": "/.well-known/x402",
      "destination": "/api/well-known-x402"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/openapi"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi"
    },
    {
      "source": "/api/starter/claims",
      "destination": "/api/starter?route=claims"
    },
    {
      "source": "/api/starter/claim-action",
      "destination": "/api/starter?route=claim-action"
    }
  ],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . \":(exclude)stats/explanation.json\""
}
